{
  "appId": "no.samm.letgo",
  "appName": "Swing Rage",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#10240f",
    "scheme": "App",
    "scrollEnabled": false,
    "allowsLinkPreview": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "launchShowDuration": 0,
      "backgroundColor": "#10240f",
      "showSpinner": false
    },
    "StatusBar": { "overlaysWebView": true, "style": "DARK" }
  }
}
