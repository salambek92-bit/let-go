{
  "name": "let-go-ios",
  "version": "1.0.0",
  "private": true,
  "description": "Swing Rage iOS app: Capacitor shell with the game bundled offline (www is copied from ../src). AdMob interstitial every 3rd game over.",
  "scripts": {
    "web": "node scripts/copy-web.mjs",
    "config": "node scripts/apply-config.mjs",
    "sync": "npm run web && npx cap sync ios && npm run config"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.4.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2"
  }
}
